.{
    .name = .sakura,
    .version = "1.0.0",
    .fingerprint = 0x018710325dc2cb59,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .sakura_ui = .{
            .path = "sakura-ui",
        },
        .clap = .{
            .url = "git+https://github.com/Hejsil/zig-clap#fc1e5cc3f6d9d3001112385ee6256d694e959d2f",
            .hash = "clap-0.11.0-oBajB7foAQC3Iyn4IVCkUdYaOVVng5IZkSncySTjNig1",
        },
        .zlua = .{
            // No "?ref=" here, unlike the other git dependencies: upstream has no
            // zig-0.16 or zig-0.17 branch (its version branches stop at
            // zig-0.15.2), so the ref this used to name did not exist. Zig never
            // read it -- the fetcher takes the ref from the URL fragment and
            // never parses the query -- but a ref that resolves to nothing is an
            // invitation to "fix" it with another wrong one. The fragment below
            // is the commit, and .hash is the source of truth regardless.
            .url = "git+https://github.com/natecraddock/ziglua#8f271c82baa5fc43aa02a72f6da020c2025d9436",
            .hash = "zlua-0.1.0-hGRpC2aABQD4D9PBVH3wAW8k32-I4969MRQ0CpOwoley",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "install.zig",
        "src",
        "res",
        // Both path dependencies must be listed here or the packaged copy does
        // not build. Their subpaths are named individually rather than listing
        // the directories, because .paths does not honour .gitignore and would
        // otherwise sweep in .zig-cache/ and the vendored zig-pkg/ trees.
        "sakura-ui/build.zig",
        "sakura-ui/build.zig.zon",
        "sakura-ui/src",
        "sakura-core/build.zig",
        "sakura-core/build.zig.zon",
        "sakura-core/src",
        "tools",
        "license.md",
        "readme.md",
    },
}
