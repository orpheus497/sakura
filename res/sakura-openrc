#!/sbin/openrc-run
# Sakura OpenRC service.

name="sakura"
description="Sakura display manager"

supervisor=supervise-daemon
respawn_period=60
pidfile=/run/"${RC_SVCNAME}.pid"

# Action purpose: the program that hands the terminal over is getty on busybox
# systems and agetty on util-linux ones. Pick whichever exists rather than
# assuming, since both are plausible on an OpenRC host.
if [ -x /sbin/getty ] || [ -x /bin/getty ]; then
	GETTY="/sbin/getty"
elif [ -x /sbin/agetty ] || [ -x /bin/agetty ]; then
	GETTY="/sbin/agetty"
fi

TTY="tty$DEFAULT_TTY"
TERM_NAME=linux
BAUD=38400

command="${GETTY}"
# -n skips the login-name prompt; -l replaces login(1) with Sakura, which does
# its own authentication.
command_args_foreground="-nl $PREFIX_DIRECTORY/bin/$EXECUTABLE_NAME ${TTY} ${BAUD} ${TERM_NAME}"

depend() {
	after agetty
	provide display-manager
	want elogind
}
