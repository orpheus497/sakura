#!/bin/sh
# Script function and purpose: SysV init script that starts Sakura directly
# on virtual terminal $DEFAULT_TTY -- no getty is involved, unlike the
# openrc, runit and s6 services. start-stop-daemon supervises the pid.
### BEGIN INIT INFO
# Provides:          sakura
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Sakura display manager
# Description:       Starts and stops the Sakura display manager
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DAEMON=$PREFIX_DIRECTORY/bin/$EXECUTABLE_NAME
TTY=/dev/tty$DEFAULT_TTY
PIDFILE=/run/sakura.pid
NAME=sakura
DESC="Sakura display manager"

. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $DESC on $TTY"
    # Action purpose: test liveness, not the mere existence of the pidfile. If
    # Sakura crashes, the pidfile outlives it; `[ -f ]` then reported "already
    # running" and exited 0, so the init system called a start successful while
    # the terminal had no login prompt and nothing retried. --status reports 0
    # only when the recorded process is actually alive, and treats a stale
    # pidfile as not running.
    if start-stop-daemon --status --pidfile "$PIDFILE"; then
        log_progress_msg "$DESC is already running"
        log_end_msg 0
        exit 0
    fi

    # Action purpose: refuse early if the terminal does not exist, rather than
    # letting the daemon start and fail where the reason is harder to see.
    if [ ! -c "$TTY" ]; then
        log_failure_msg "$TTY does not exist"
        log_end_msg 1
        exit 1
    fi

    # setsid: Sakura must be a session leader to own the terminal and to switch
    # virtual terminals. stdin/stdout are redirected to the terminal it owns.
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --startas /bin/sh -- -c "exec setsid $DAEMON <$TTY >$TTY 2>&1"
    log_end_msg $?
    ;;

  stop)
    log_daemon_msg "Stopping $DESC"
    start-stop-daemon --stop --retry TERM/5/KILL/5 --pidfile "$PIDFILE" --oknodo
    status=$?
    rm -f "$PIDFILE"
    log_end_msg $status
    ;;

  restart|force-reload)
    "$0" stop
    "$0" start
    ;;

  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" && exit 0 || exit $?
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
    exit 1
    ;;
esac

exit 0
