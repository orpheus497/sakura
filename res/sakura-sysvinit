#!/bin/sh
# Script function and purpose: SysV init script that starts Sakura directly
# on virtual terminal $DEFAULT_TTY -- no getty is involved, unlike the
# openrc, runit and s6 services. start-stop-daemon supervises the pid.
### BEGIN INIT INFO
# Provides:          sakura
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Sakura display manager
# Description:       Starts and stops the Sakura display manager
### END INIT INFO

PATH=/sbin:/usr/sbin:/bin:/usr/bin
DAEMON=$PREFIX_DIRECTORY/bin/$EXECUTABLE_NAME
TTY=/dev/tty$DEFAULT_TTY
PIDFILE=/run/sakura.pid
NAME=sakura
DESC="Sakura display manager"

. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $DESC on $TTY"
    # Action purpose: test liveness, not the mere existence of the pidfile. If
    # Sakura crashes, the pidfile outlives it; `[ -f ]` then reported "already
    # running" and exited 0, so the init system called a start successful while
    # the terminal had no login prompt and nothing retried. --status reports 0
    # only when the recorded process is actually alive, and treats a stale
    # pidfile as not running.
    if start-stop-daemon --status --pidfile "$PIDFILE"; then
        log_progress_msg "$DESC is already running"
        log_end_msg 0
        exit 0
    fi

    # Action purpose: refuse early if the terminal does not exist, rather than
    # letting the daemon start and fail where the reason is harder to see.
    if [ ! -c "$TTY" ]; then
        log_failure_msg "$TTY does not exist"
        log_end_msg 1
        exit 1
    fi

    # Action purpose: setsid runs *before* the redirections, and the nesting is
    # what makes that happen. credentials(7) gives the rule -- "The controlling
    # terminal is established when the session leader first opens a terminal
    # (unless the O_NOCTTY flag is specified when calling open(2))". In the
    # single-level form the redirections were performed by this script's shell,
    # which is not a session leader, and setsid created the session only
    # afterwards: the new leader inherited open descriptors but no controlling
    # terminal. Measured, /dev/tty was then unopenable, which costs the user's
    # shell its job control, because nothing in Sakura calls TIOCSCTTY itself.
    # Here the inner shell *is* the session leader when it opens $TTY, so the
    # kernel assigns the terminal on the open -- confirmed under strace: ctty
    # acquired, zero TIOCSCTTY calls.
    #
    # Deliberately not `setsid --ctty`, which looks equivalent and fails worse:
    # when its ioctl is refused -- as it is when a getty still holds the VT --
    # it warns, exits 0, and never runs the program at all, reporting a
    # successful start with no login prompt. That is the same silent failure
    # the pidfile liveness check above exists to prevent.
    start-stop-daemon --start --background --make-pidfile --pidfile "$PIDFILE" \
        --startas /bin/sh -- -c "exec setsid /bin/sh -c 'exec $DAEMON <$TTY >$TTY 2>&1'"
    log_end_msg $?
    ;;

  stop)
    log_daemon_msg "Stopping $DESC"
    start-stop-daemon --stop --retry TERM/5/KILL/5 --pidfile "$PIDFILE" --oknodo
    status=$?
    rm -f "$PIDFILE"
    log_end_msg $status
    ;;

  restart|force-reload)
    "$0" stop
    "$0" start
    ;;

  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME" && exit 0 || exit $?
    ;;

  *)
    echo "Usage: $0 {start|stop|restart|force-reload|status}" >&2
    exit 1
    ;;
esac

exit 0
